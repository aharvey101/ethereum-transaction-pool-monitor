# Ethereum RPC Configuration
# For production MEV bot use WebSocket for real-time mempool monitoring:
# ETH_RPC_URL=wss://mainnet.infura.io/ws/v3/YOUR_PROJECT_ID
# ETH_RPC_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Default: http://192.168.0.14:8545 (local node)
ETH_RPC_URL=http://192.168.0.14:8545

# For localhost:
# ETH_RPC_URL=http://localhost:8545

# For remote server:
# ETH_RPC_URL=http://your-server-ip:8545

# For Alchemy (recommended for reliability):
# ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# For Infura:
# ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID

# MEV Bot Configuration
# Private key for transaction signing (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Deployed FlashLoanSandwich contract address
SANDWICH_CONTRACT_ADDRESS=0x79E2a11cD852479c91C63660F69A9b1e7bA5dfE8

# Bot settings
MIN_PROFIT_ETH=0.005
MAX_GAS_PRICE_GWEI=200
ENABLE_FLASHBOTS=true

# Database Configuration  
DB_PATH=dex_pools.db

# Chain Configuration
CHAIN_ID=1

# Optional: Enable debug mode (headless logging)
# DEBUG_MODE=1

# Optional: Force complete pool refresh on startup
# FORCE_POOL_REFRESH=1
